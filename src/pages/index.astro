---
import { Image } from 'astro:assets';

import appStoreBadge from '../assets/app-store-badge.svg';
import chatPhone from '../assets/shots/chat-phone.png';
import multiwindowIpad from '../assets/shots/multiwindow-review.png';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const site = Astro.site ?? Astro.url;
const canonical = new URL(Astro.url.pathname, site).href;
const ogImage = new URL(`${base}/og.png`, site).href;

const headline = 'Steer AI coding agents from iPhone and iPad';
const pageTitle = `${headline} — Agent Console`;
const description =
	'Connect to AI coding agents running on your Mac, PC, or cloud VM from a native iPhone and iPad app.';
const appStore = 'https://apps.apple.com/app/id6786123190';

const primaryFeatures = [
	{
		title: 'Chat',
		body: 'Follow tool calls and answer questions as they come up.',
	},
	{
		title: 'Changes and files',
		body: 'Review diffs, browse the repository, and edit files.',
	},
	{
		title: 'Terminal',
		body: 'Open a shell on the host.',
	},
];

const footerLinks = [
	{ label: 'Docs', href: `${base}/docs/overview/` },
	{ label: 'Privacy', href: `${base}/privacy/` },
	{ label: 'Feedback', href: 'https://github.com/Qusic/agent-console/discussions' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{pageTitle}</title>
		<meta name="description" content={description} />
		<link rel="canonical" href={canonical} />
		<link rel="icon" type="image/png" href={`${base}/favicon.png`} />
		<meta name="color-scheme" content="dark" />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="Agent Console" />
		<meta property="og:title" content={pageTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta name="twitter:card" content="summary_large_image" />
	</head>

	<body>
		<a class="skip-link" href="#main-content">Skip to content</a>
		<div class="glow" aria-hidden="true"></div>

		<header class="nav">
			<a class="brand" href={`${base}/`} aria-label="Agent Console home">
				<img src={`${base}/favicon.png`} width="30" height="30" alt="" />
				<span class="wordmark">Agent Console</span>
			</a>
			<nav aria-label="Primary">
				<a class="nav-link" href={`${base}/docs/overview/`}>Docs</a>
				<a class="nav-cta" href={appStore}>Download</a>
			</nav>
		</header>

		<main id="main-content">
			<section class="hero">
				<div>
					<h1>{headline}</h1>
					<p class="lede">
						Agents run on your Mac, PC, or cloud VM. Follow their work, answer questions,
						review diffs, and use a terminal from the app.
					</p>
					<a class="store-badge" href={appStore} aria-label="Download Agent Console on the App Store">
						<img
							src={appStoreBadge.src}
							width="150"
							height="50"
							alt="Download on the App Store"
						/>
					</a>
				</div>

				<div class="showcase showcase-phone">
					<Image
						class="device"
						src={chatPhone}
						alt="Agent Console on iPhone: an agent searching and editing files, pausing to ask permission to run a command"
						loading="eager"
						layout="constrained"
						width={660}
						widths={[330, 660]}
						sizes="(min-width: 52rem) 19rem, 72vw"
					/>
				</div>
			</section>

			<section class="features" aria-label="Product capabilities">
				<div class="feature-panel">
					<div class="work">
						<h2>In a session</h2>
						<div class="feature-list">
							{
								primaryFeatures.map((feature) => (
									<article class="feature-item">
										<h3>{feature.title}</h3>
										<p>{feature.body}</p>
									</article>
								))
							}
						</div>
					</div>

					<div class="setup">
						<div class="setup-copy">
							<h2>Host and protocol</h2>
							<p>
								Run the host on a Mac, PC, or cloud VM. Agent Console connects over the public,
								MIT-licensed Agent Host Protocol and has no backend of its own.
							</p>
						</div>
						<nav class="setup-links" aria-label="Learn more">
							<a href={`${base}/docs/agent-host-protocol/`}>
								About the Agent Host Protocol →
							</a>
							<a href={`${base}/docs/connections/`}>How connections work →</a>
						</nav>
					</div>
				</div>
			</section>

			<section class="ipad">
				<h2>Two sessions, side by side</h2>
				<div class="showcase showcase-tablet">
					<Image
						class="device"
						src={multiwindowIpad}
						alt="Two Agent Console windows side by side on iPad: one agent asks structured product-search questions while a code diff from another session is reviewed"
						loading="lazy"
						layout="constrained"
						width={1800}
						widths={[480, 720, 960, 1440, 1800]}
						sizes="min(56rem, calc(100vw - 2.5rem))"
					/>
				</div>
			</section>

			<section class="closing">
				<h2>Your machines, your code, your control.</h2>
				<a class="store-badge" href={appStore} aria-label="Download Agent Console on the App Store">
					<img
						src={appStoreBadge.src}
						width="150"
						height="50"
						alt="Download on the App Store"
					/>
				</a>
			</section>
		</main>

		<footer class="site-footer">
			<a class="brand" href={`${base}/`} aria-label="Agent Console home">
				<img src={`${base}/favicon.png`} width="26" height="26" alt="" />
				<span class="wordmark">Agent Console</span>
			</a>
			<nav aria-label="Footer">
				{footerLinks.map((link) => <a href={link.href}>{link.label}</a>)}
			</nav>
		</footer>
	</body>
</html>

<style>
	:root {
		--bg: #00122e;
		--bg-raised: #001f50;
		--text: #e9eefb;
		--muted: #9bafd4;
		--glass: rgb(255 255 255 / 0.045);
		--glass-line: rgb(255 255 255 / 0.11);
		--font: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial,
			sans-serif;
	}

	* {
		box-sizing: border-box;
	}

	body {
		margin: 0;
		background: var(--bg);
		color: var(--text);
		font-family: var(--font);
		line-height: 1.6;
		-webkit-font-smoothing: antialiased;
		overflow-x: hidden;
	}

	/* Blurred colour fields behind everything. Glass panels need something to
	   refract; on a flat fill they read as grey plastic. */
	.glow {
		position: fixed;
		inset: 0;
		z-index: -1;
		background:
			radial-gradient(50rem 30rem at 50% -8%, rgb(37 117 244 / 0.5), transparent 70%),
			radial-gradient(38rem 26rem at 12% 22%, rgb(64 196 255 / 0.16), transparent 70%),
			radial-gradient(42rem 30rem at 88% 62%, rgb(120 80 255 / 0.18), transparent 70%),
			linear-gradient(180deg, var(--bg-raised), var(--bg) 45%);
	}

	a {
		color: inherit;
	}

	.skip-link {
		position: fixed;
		inset: 0.75rem auto auto 0.75rem;
		z-index: 20;
		padding: 0.6rem 1rem;
		border-radius: 0.5rem;
		background: #fff;
		color: var(--bg);
		font-weight: 600;
		text-decoration: none;
		transform: translateY(calc(-100% - 1rem));
	}
	.skip-link:focus {
		transform: none;
	}

	h1,
	h2 {
		line-height: 1.12;
		letter-spacing: -0.02em;
		margin: 0;
		text-wrap: balance;
	}

	.lede {
		color: var(--muted);
		font-size: 1.125rem;
		margin: 1.25rem auto 0;
		max-width: 34rem;
		text-wrap: pretty;
	}

	.nav-cta {
		display: inline-block;
		padding: 0.45rem 1.1rem;
		border: 1px solid rgb(255 255 255 / 0.18);
		border-radius: 999px;
		background: linear-gradient(180deg, #1c68dc, #155dca);
		color: #fff;
		font-size: 0.9rem;
		font-weight: 600;
		text-decoration: none;
		transition: transform 0.15s ease, filter 0.15s ease;
	}
	.nav-cta:hover {
		filter: brightness(1.08);
		transform: translateY(-1px);
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.6rem;
		color: var(--text);
		text-decoration: none;
	}
	.brand img {
		display: block;
		border-radius: 22%;
	}
	.wordmark {
		font-weight: 650;
		letter-spacing: -0.01em;
	}

	.store-badge {
		display: inline-flex;
		border-radius: 0.55rem;
		transition: transform 0.15s ease, filter 0.15s ease;
	}
	.store-badge:hover {
		filter: brightness(1.08);
		transform: translateY(-1px);
	}
	.store-badge img {
		display: block;
		width: 9.375rem;
		height: auto;
	}

	/* ---- nav ---- */
	.nav {
		position: sticky;
		top: 0;
		z-index: 10;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding: 0.75rem max(1.25rem, 50% - 34rem);
		background: rgb(0 18 46 / 0.6);
		-webkit-backdrop-filter: blur(14px) saturate(1.4);
		backdrop-filter: blur(14px) saturate(1.4);
		border-bottom: 1px solid var(--glass-line);
	}
	.nav nav {
		display: flex;
		align-items: center;
		gap: 1.5rem;
	}
	.nav-link {
		color: var(--muted);
		text-decoration: none;
	}
	.nav-link:hover {
		color: var(--text);
	}

	/* ---- layout ---- */
	main {
		max-width: 68rem;
		margin-inline: auto;
		padding-inline: 1.25rem;
	}

	section {
		text-align: center;
	}

	/* ---- hero ---- */
	.hero {
		display: grid;
		justify-items: center;
		padding-block: clamp(3rem, 9vw, 5rem) 0;
	}
	.hero h1 {
		font-size: clamp(2.4rem, 6vw, 4rem);
		max-width: 18ch;
		margin-inline: auto;
	}
	.hero .store-badge {
		margin-block-start: 2.25rem;
	}

	/* Screens are shown whole: the approval prompt near the bottom of the chat is
	   the most telling moment in the product, and cropping cut it off. */
	.showcase {
		--frame-size: 4px;
		--frame-radius: clamp(1rem, 2vw, 1.8rem);
		--screen-radius: clamp(0.8rem, 1.7vw, 1.5rem);
		position: relative;
		margin-inline: auto;
		padding: var(--frame-size);
		border: 1px solid rgb(255 255 255 / 0.16);
		border-radius: var(--frame-radius);
		background: linear-gradient(
			145deg,
			rgb(220 232 255 / 0.55),
			rgb(67 91 130 / 0.48) 18%,
			rgb(5 18 40 / 0.96) 55%,
			rgb(18 48 88 / 0.88) 84%,
			rgb(126 164 222 / 0.42)
		);
		box-shadow:
			inset 0 1px rgb(255 255 255 / 0.38),
			inset 1px 0 rgb(255 255 255 / 0.1),
			inset 0 -1px rgb(0 0 0 / 0.55),
			0 2.25rem 5rem -1.4rem rgb(0 0 0 / 0.75),
			0 0 4rem -1.75rem rgb(37 117 244 / 0.3);
	}
	.showcase::before {
		content: '';
		position: absolute;
		inset: 1px;
		z-index: 1;
		border-radius: inherit;
		box-shadow: inset 0 1px rgb(255 255 255 / 0.22);
		pointer-events: none;
	}
	.showcase-phone {
		--frame-size: 6px;
		--frame-radius: 12% / 5.5%;
		--screen-radius: 10.7% / 4.9%;
		width: min(19rem, 72vw);
		margin-block-start: 3.5rem;
	}
	.showcase-tablet {
		width: min(56rem, 100%);
	}

	.device {
		display: block;
		width: 100%;
		height: auto;
		border: 1px solid rgb(0 7 20 / 0.72);
		border-radius: var(--screen-radius);
		background: #07152b;
		box-shadow: 0 0 0 1px rgb(255 255 255 / 0.055);
	}

	/* ---- capabilities ---- */
	.features {
		margin-block-start: clamp(4rem, 8vw, 6rem);
	}
	.feature-panel {
		position: relative;
		overflow: hidden;
		background: linear-gradient(145deg, rgb(255 255 255 / 0.065), var(--glass));
		-webkit-backdrop-filter: blur(12px);
		backdrop-filter: blur(12px);
		border: 1px solid var(--glass-line);
		border-radius: 1.25rem;
		text-align: start;
	}
	.feature-panel::before {
		content: '';
		position: absolute;
		inset: 0.5px 1.25rem auto;
		height: 1px;
		background: linear-gradient(90deg, transparent, rgb(255 255 255 / 0.22), transparent);
	}
	.work,
	.setup {
		padding: clamp(1.5rem, 4vw, 2.5rem);
	}
	.work > h2,
	.setup-copy h2 {
		font-size: 1.25rem;
		margin-block-end: 1.25rem;
	}
	.feature-item {
		padding-block: 1.1rem;
	}
	.feature-item:first-child {
		padding-block-start: 0;
	}
	.feature-item:last-child {
		padding-block-end: 0;
	}
	.feature-item + .feature-item {
		border-top: 1px solid var(--glass-line);
	}
	.feature-item h3 {
		margin: 0 0 0.35rem;
		font-size: 1rem;
		line-height: 1.4;
	}
	.feature-item p,
	.setup-copy p {
		margin: 0;
		color: var(--muted);
		font-size: 0.9375rem;
	}
	.setup {
		border-top: 1px solid var(--glass-line);
		background: rgb(0 18 46 / 0.2);
	}
	.setup-copy {
		max-width: 43rem;
	}
	.setup-links {
		display: grid;
		gap: 0.55rem;
		margin-block-start: 1.5rem;
	}
	.setup-links a {
		width: fit-content;
		color: var(--text);
		font-size: 0.9375rem;
		font-weight: 600;
		text-decoration: none;
	}
	.setup-links a:hover {
		color: #fff;
	}

	/* ---- ipad ---- */
	.ipad {
		display: grid;
		align-items: center;
		gap: 2.5rem;
		margin-block-start: clamp(5rem, 10vw, 8rem);
	}
	.ipad h2,
	.closing h2 {
		font-size: clamp(1.75rem, 3.5vw, 2.5rem);
	}
	/* ---- closing ---- */
	.closing {
		margin-block: clamp(4rem, 9vw, 7rem);
	}
	.closing .store-badge {
		margin-block-start: 2rem;
	}

	/* ---- footer ---- */
	.site-footer {
		max-width: 68rem;
		margin-inline: auto;
		padding: 2rem 1.25rem 3rem;
		border-top: 1px solid var(--glass-line);
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem 2rem;
		font-size: 0.9375rem;
	}
	.site-footer nav {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.5rem;
	}
	.site-footer a {
		color: var(--muted);
		text-decoration: none;
	}
	.site-footer .brand {
		color: var(--text);
	}
	.site-footer a:hover {
		color: var(--text);
	}

	@media (min-width: 44rem) {
		.feature-list {
			display: grid;
			grid-template-columns: repeat(3, minmax(0, 1fr));
		}
		.feature-item {
			padding: 0 1.5rem;
		}
		.feature-item:first-child {
			padding-inline-start: 0;
		}
		.feature-item:last-child {
			padding-inline-end: 0;
		}
		.feature-item + .feature-item {
			border-top: 0;
			border-left: 1px solid var(--glass-line);
		}
		.setup {
			display: grid;
			grid-template-columns: minmax(0, 1fr) auto;
			align-items: end;
			gap: 2rem;
		}
		.setup-links {
			margin-block-start: 0;
		}
	}

	@media (min-width: 52rem) {
		.hero {
			grid-template-columns: minmax(0, 1fr) minmax(17rem, 20rem);
			align-items: center;
			justify-items: stretch;
			gap: clamp(3rem, 7vw, 6rem);
			padding-block: clamp(3rem, 6vh, 4rem);
			text-align: start;
		}
		.hero h1 {
			font-size: clamp(3.25rem, 5vw, 4.5rem);
			max-width: 13ch;
			margin-inline: 0;
		}
		.hero .lede {
			max-width: 31rem;
			margin-inline: 0;
		}
		.showcase-phone {
			width: min(19rem, 100%);
			margin-block-start: 0;
			justify-self: center;
		}
	}

</style>
